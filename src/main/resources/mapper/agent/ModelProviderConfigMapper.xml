<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jam.agent.agent.model.persistence.mapper.ModelProviderConfigMapper">

    <resultMap id="ProviderResult" type="com.jam.agent.agent.model.persistence.entity.ModelProviderConfigEntity">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="providerKey" column="provider_key"/>
        <result property="providerName" column="provider_name"/>
        <result property="protocolType" column="protocol_type"/>
        <result property="baseUrl" column="base_url"/>
        <result property="apiKey" column="api_key"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectEnabledByProviderKey" resultMap="ProviderResult">
        SELECT id, user_id, provider_key, provider_name, protocol_type,
               base_url, api_key, status, created_at, updated_at
        FROM model_provider_config
        WHERE provider_key = #{providerKey}
          AND status = 1
    </select>

</mapper>
