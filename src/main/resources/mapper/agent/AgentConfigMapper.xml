<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jam.agent.agent.persistence.mapper.AgentConfigMapper">

    <resultMap id="AgentConfigResult" type="com.jam.agent.agent.persistence.entity.AgentConfigEntity">
        <id property="id" column="id"/>
        <result property="agentKey" column="agent_key"/>
        <result property="executionType" column="execution_type"/>
        <result property="executionKey" column="execution_key"/>
        <result property="systemPrompt" column="system_prompt"/>
        <result property="enabledPlugins" column="enabled_plugins"/>
        <result property="enabledTools" column="enabled_tools"/>
        <result property="magicParams" column="magic_params"/>
        <result property="imageHistoryMode" column="image_history_mode"/>
        <result property="modelProviderKey" column="model_provider_key"/>
        <result property="modelName" column="model_name"/>
        <result property="modelTemperature" column="model_temperature"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectByAgentKey" resultMap="AgentConfigResult">
        SELECT id, agent_key, execution_type, execution_key, system_prompt, enabled_plugins,
               enabled_tools, magic_params, image_history_mode, model_provider_key, model_name,
               model_temperature, created_at, updated_at
        FROM agent_config
        WHERE agent_key = #{agentKey}
    </select>

</mapper>
